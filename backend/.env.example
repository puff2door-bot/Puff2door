MONGO_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=puff2door
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SITE_URL=https://puff2door.com
PUBLIC_URL=https://puff2door.com
CORS_ORIGINS=https://puff2door.com,https://www.puff2door.com
GOOGLE_CLIENT_ID=

# Optional no-monthly-fee browser push. Generate one VAPID key pair and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:puff2door@gmail.com

# Optional direct Clover inventory sync. Prefer a merchant API token from
# Clover Account & Setup > API Tokens. The token stays on the server.
# CLOVER_MERCHANT_ID is the 13-character id in clover.com/home/m/<id>.
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=
CLOVER_ENV=production

# OAuth app settings. Leave blank when CLOVER_API_TOKEN is set.
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
CLOVER_REDIRECT_URI=https://puff2door.com/api/clover/oauth/callback
CLOVER_WEBHOOK_AUTH_CODE=

# One-way Clover catalog sync. Leave false until a few items have been checked.
CLOVER_SYNC_ENABLED=false
CLOVER_SYNC_DRY_RUN=false

# Optional email delivery
RESEND_API_KEY=
EMAIL_FROM=HD Smoke Shop <orders@puff2door.com>
NOTIFY_EMAIL=

# Local/QA only. Keep false in production so an email failure never exposes a reset token.
ALLOW_PASSWORD_RESET_TOKEN_RESPONSE=false

# Optional payment providers. Leave blank until live credentials are ready.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=production
ZELLE_EMAIL=
ZELLE_NAME=

# Never enable the simulated test card in production.
ALLOW_TEST_CARD=false
